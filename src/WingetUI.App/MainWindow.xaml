<Window x:Class="WingetUI.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WingetUI" Icon="Assets/WingetUI.ico" Width="1180" Height="720" MinWidth="920" MinHeight="540" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
 <Window.Resources>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#171B22"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#202630"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E6EAF0"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6EAF0"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#3C4655"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315EAB"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="30"/>
   <Setter Property="Padding" Value="12,5"/>
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
   <Setter Property="MinWidth" Value="128"/>
   <Setter Property="Margin" Value="0,0,12,6"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="Nav" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent">
       <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Nav" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="BorderThickness" Value="1"/><Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
   <Setter Property="Padding" Value="10,8"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Padding" Value="10,5"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ProgressBar">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
   <Setter Property="Background" Value="#343D49"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="MinHeight" Value="40"/>
   <Setter Property="MaxWidth" Value="640"/>
   <Setter Property="HorizontalAlignment" Value="Left"/>
   <Setter Property="MinWidth" Value="360"/>
  </Style>
  <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
  <Style x:Key="Packages" TargetType="DataGrid">
   <Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="SelectionUnit" Value="FullRow"/>
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
   <Setter Property="RowBackground" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
   <Setter Property="RowHeight" Value="36"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
   <Setter Property="RowHeaderWidth" Value="0"/>
  </Style>
 </Window.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
   <DockPanel>
    <Button Content="Toggle _theme" Click="ToggleTheme" DockPanel.Dock="Right" Margin="8,0,0,0"/>
    <Button x:Name="ElevateButton" DockPanel.Dock="Right" Content="Restart as _administrator"
     Click="RestartAsAdministrator" Padding="8,4"/>
    <TextBlock Text="WingetUI" FontSize="24" FontWeight="SemiBold"/>
   </DockPanel>
   <TextBlock Text="Manage your apps · WinGet community source (winget)" Margin="0,6,0,0"/>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <StackPanel>
   <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding OperationStatus}" Margin="0,3,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding Percentage, Mode=OneWay}"
    IsIndeterminate="{Binding Indeterminate}" Visibility="{Binding Busy, Converter={StaticResource VisibleWhenTrue}}"
    AutomationProperties.Name="Current package operation progress"/>
  </StackPanel>
  </Border>
  <TabControl TabStripPlacement="Left" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderThickness="0" Padding="12">
   <TabItem Header="_Updates">
    <DockPanel>
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button Content="_Refresh" Command="{Binding RefreshCommand}" Padding="8,4"/>
      <Button Style="{StaticResource PrimaryButton}" x:Name="UpgradeButton" Content="_Upgrade selected (0)" IsEnabled="False" Click="UpgradeSelected" Padding="8,4" Margin="6,0"/>
      <Button Content="Select _all" Click="SelectAllUpdates" Padding="8,4"/>
      <Button Content="_Clear selection" Click="ClearUpdates" Padding="8,4" Margin="6,0"/>
      <TextBlock Text="{Binding LastRefresh}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
     </StackPanel>
     <DataGrid x:Name="UpdatesGrid" Style="{StaticResource Packages}" ItemsSource="{Binding Updates}" AutomationProperties.Name="Available updates">
      <DataGrid.Columns>
       <DataGridTemplateColumn Width="64" CanUserSort="False">
        <DataGridTemplateColumn.Header>
         <CheckBox x:Name="SelectAllCheckbox" IsEnabled="False"
          Click="SelectAllCheckboxClicked" HorizontalAlignment="Center"
          AutomationProperties.Name="Select all updates"
          ToolTip="Select or clear all updates"/>
        </DataGridTemplateColumn.Header>
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
           AutomationProperties.Name="{Binding Package.Name, StringFormat='Select {0} for upgrade'}"
           IsChecked="{Binding IsChecked, Mode=OneWay}" Click="UpdateCheckboxClicked"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Name" Width="*" MinWidth="150">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate><TextBlock Text="{Binding Package.Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Package.Name}"/></DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Package ID" Width="2*" MinWidth="180">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate><TextBlock Text="{Binding Package.Id}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Package.Id}"/></DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="Source" Binding="{Binding Package.Source}"/>
       <DataGridTextColumn Header="Installed" Binding="{Binding Package.Installed}"/>
       <DataGridTemplateColumn Header="Available" Width="150">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate><TextBlock Text="{Binding Package.Available}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Package.Available}"/></DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="Eligibility" Visibility="Collapsed" Binding="{Binding Package.Eligibility}"/>
       <DataGridTemplateColumn Header="Progress" Width="220">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <StackPanel Margin="4,1">
           <DockPanel>
            <TextBlock Text="{Binding Operation.RowStatus, TargetNullValue=Ready}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Operation.ProgressDetail}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Operation.ProgressDetail}"/>
           </DockPanel>
           <ProgressBar Height="5" Maximum="100" Value="{Binding Operation.ProgressValue, Mode=OneWay}"
            IsIndeterminate="{Binding Operation.ProgressIndeterminate, FallbackValue=False}"
            Visibility="{Binding Operation.ShowProgress, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"
            AutomationProperties.Name="{Binding Package.Name, StringFormat='Upgrade progress for {0}'}"/>
          </StackPanel>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="_Search">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="6">
      <Label Content="_Search packages" Target="{Binding ElementName=QueryBox}"/>
      <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Style="{StaticResource PrimaryButton}" Content="_Review selected package" Click="InstallSelected" HorizontalAlignment="Left" Margin="0,6" Padding="8,4"/>
     </StackPanel>
     <DataGrid x:Name="SearchGrid" Style="{StaticResource Packages}" ItemsSource="{Binding SearchResults}" SelectionMode="Single" AutomationProperties.Name="Search results">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="Package ID" Binding="{Binding Id}" Width="2*" MinWidth="160"/>
       <DataGridTextColumn Header="Source" Binding="{Binding Source}"/>
       <DataGridTextColumn Header="Installed" Binding="{Binding Installed}"/>
       <DataGridTextColumn Header="Available" Binding="{Binding Available}"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="_Installed">
    <DataGrid Style="{StaticResource Packages}" ItemsSource="{Binding Installed}" AutomationProperties.Name="Installed packages">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
      <DataGridTextColumn Header="Package ID" Binding="{Binding Id}" Width="2*" MinWidth="160"/>
      <DataGridTextColumn Header="Source" Binding="{Binding Source}"/>
      <DataGridTextColumn Header="Installed" Binding="{Binding Installed}"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="_Activity">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <Button Content="_Remove queued item" Click="RemoveQueued" Padding="8,4"/>
      <Button Content="_Copy details" Click="CopyDetails" Padding="8,4" Margin="6,0"/>
     </StackPanel>
     <DataGrid x:Name="ActivityList" Style="{StaticResource Packages}" ItemsSource="{Binding Activity}"
      SelectionMode="Single" AutomationProperties.Name="Package activity">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Queued" Binding="{Binding Created, StringFormat=g}"/>
       <DataGridTextColumn Header="Action" Binding="{Binding Action}"/>
       <DataGridTextColumn Header="Package" Binding="{Binding Package.Name}" Width="*"/>
       <DataGridTextColumn Header="Package ID" Binding="{Binding Package.Id}" Width="*"/>
       <DataGridTextColumn Header="From" Binding="{Binding Package.Installed}"/>
       <DataGridTextColumn Header="To" Binding="{Binding Package.Available}"/>
       <DataGridTextColumn Header="Status" Binding="{Binding RowStatus}"/>
       <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="2*" MinWidth="160"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
