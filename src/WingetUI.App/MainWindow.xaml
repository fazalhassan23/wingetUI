<Window x:Class="WingetUI.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WingetUI" Width="1050" Height="650" MinWidth="700" MinHeight="420">
 <Window.Resources>
  <Style x:Key="Packages" TargetType="DataGrid">
   <Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="SelectionUnit" Value="FullRow"/>
  </Style>
 </Window.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
   <DockPanel>
    <Button x:Name="ElevateButton" DockPanel.Dock="Right" Content="Restart as _administrator"
     Click="RestartAsAdministrator" Padding="8,4"/>
    <TextBlock Text="WingetUI" FontSize="28" FontWeight="SemiBold"/>
   </DockPanel>
   <TextBlock Text="WinGet community source (winget)"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding OperationStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Percentage, Mode=OneWay}"
    IsIndeterminate="{Binding Indeterminate}" AutomationProperties.Name="Package operation progress"/>
  </StackPanel>
  <TabControl>
   <TabItem Header="_Updates">
    <DockPanel>
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="6">
      <Button Content="_Refresh" Command="{Binding RefreshCommand}" Padding="8,4"/>
      <Button x:Name="UpgradeButton" Content="_Upgrade selected (0)" IsEnabled="False" Click="UpgradeSelected" Padding="8,4" Margin="6,0"/>
      <Button Content="Select _all" Click="SelectAllUpdates" Padding="8,4"/>
      <Button Content="_Clear selection" Click="ClearUpdates" Padding="8,4" Margin="6,0"/>
      <TextBlock Text="{Binding LastRefresh}" VerticalAlignment="Center"/>
     </StackPanel>
     <DataGrid x:Name="UpdatesGrid" Style="{StaticResource Packages}" ItemsSource="{Binding Updates}" AutomationProperties.Name="Available updates">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="Select" Width="64">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
           AutomationProperties.Name="{Binding Package.Name, StringFormat='Select {0} for upgrade'}"
           IsChecked="{Binding IsChecked, Mode=OneWay}" Click="UpdateCheckboxClicked"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="Name" Binding="{Binding Package.Name}" Width="*"/>
       <DataGridTextColumn Header="Package ID" Binding="{Binding Package.Id}" Width="2*"/>
       <DataGridTextColumn Header="Source" Binding="{Binding Package.Source}"/>
       <DataGridTextColumn Header="Installed" Binding="{Binding Package.Installed}"/>
       <DataGridTextColumn Header="Available" Binding="{Binding Package.Available}"/>
       <DataGridTextColumn Header="Eligibility" Binding="{Binding Package.Eligibility}"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="_Search">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="6">
      <Label Content="_Search packages" Target="{Binding ElementName=QueryBox}"/>
      <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="_Review selected package" Click="InstallSelected" HorizontalAlignment="Left" Margin="0,6" Padding="8,4"/>
     </StackPanel>
     <DataGrid x:Name="SearchGrid" Style="{StaticResource Packages}" ItemsSource="{Binding SearchResults}" SelectionMode="Single" AutomationProperties.Name="Search results">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="Package ID" Binding="{Binding Id}" Width="2*"/>
       <DataGridTextColumn Header="Source" Binding="{Binding Source}"/>
       <DataGridTextColumn Header="Installed" Binding="{Binding Installed}"/>
       <DataGridTextColumn Header="Available" Binding="{Binding Available}"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="_Installed">
    <DataGrid Style="{StaticResource Packages}" ItemsSource="{Binding Installed}" AutomationProperties.Name="Installed packages">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
      <DataGridTextColumn Header="Package ID" Binding="{Binding Id}" Width="2*"/>
      <DataGridTextColumn Header="Source" Binding="{Binding Source}"/>
      <DataGridTextColumn Header="Installed" Binding="{Binding Installed}"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="_Activity">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
      <Button Content="_Remove queued item" Click="RemoveQueued" Padding="8,4"/>
      <Button Content="_Copy details" Click="CopyDetails" Padding="8,4" Margin="6,0"/>
     </StackPanel>
     <ListBox x:Name="ActivityList" ItemsSource="{Binding Activity}" DisplayMemberPath="Display" AutomationProperties.Name="Package activity"/>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
